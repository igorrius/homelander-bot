# Copy to .env for local development. Placeholders only: never commit real values.

# Required. HMAC key for login codes and tokens, at least 32 bytes (e.g. `openssl rand -hex 32`).
APP_SECRET=change-me-to-32-random-bytes-or-more
# Required. Base URL people open; https, or http only for localhost.
PUBLIC_URL=http://localhost:8080
# Required. Token from @BotFather.
TELEGRAM_BOT_TOKEN=000000:placeholder

# Listen address. Leave unset on Railway: it then follows $PORT. Default :8080.
# HTTP_ADDR=:8080
# SQLite database file; its directory is created on start.
DATABASE_PATH=./data/homelander.db
# How the bot receives updates: polling (default) or webhook.
TELEGRAM_UPDATES=polling
# Required when TELEGRAM_UPDATES=webhook. Random string Telegram sends back with each update.
TELEGRAM_WEBHOOK_SECRET=
# Phone of the first admin; used only while no admin exists.
BOOTSTRAP_ADMIN_PHONE=
# Default language: uk or en.
DEFAULT_LOCALE=uk
# Region used to read phone numbers written without a country code.
DEFAULT_PHONE_REGION=UA
# Session lifetimes: idle timeout and absolute maximum.
SESSION_IDLE_TTL=12h
SESSION_MAX_TTL=168h
# debug, info, warn or error.
LOG_LEVEL=info
